# App general settings
DEBUG=True
APP_NAME=LEGAL WATCH DOG
APP_VERSION=1.0.0
APP_PORT=YOUR_APP_PORT_HERE
ENVIRONMENT=development
SECRET_KEY=YOUR_SECRET_KEY_HERE
LEGAL_WATCH_DOG_BASE_URL=https://api.legalwatchdog.hng

# App URLs
APP_URL=https://minamoto.emerj.net
DEV_URL=http://localhost:3000

# Realtime websocket settings
ENABLE_REALTIME_WEBSOCKETS=false
REALTIME_WEBSOCKET_PATH=/ws
REALTIME_NOTIFICATIONS_CHANNEL=events:notifications
REALTIME_SCRAPE_CHANNEL=events:scrape_jobs
REALTIME_HEARTBEAT_INTERVAL=30cc

# Database configuration
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASS=password
DB_NAME=dbname
DATABASE_URL=postgresql://postgres:password@localhost/user
DB_SSL=true

# Email configuration
MAIL_MAILER=smtp
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
MAIL_USERNAME=YOUR_MAIL_USERNAME
MAIL_PASSWORD=YOUR_MAIL_PASSWORD
MAIL_ENCRYPTION=TLS
EMAIL=YOUR_MAIL
MAIL_FROM_NAME="LEGAL WATCH DOG"

# Security & Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
ACCESS_TOKEN_EXPIRATION=""
ENCRYPTION_KEY=your-32-byte-encryption-key

# Superadmin Credentials (for initial setup only)
SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_PASSWORD=ChangeThisToSecurePassword123!

# LLM Configuration - OpenRouter (Primary)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=google/gemini-3-flash-preview
OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash-lite,deepseek/deepseek-v3.2
OPENROUTER_ENABLE_LOGGING=true
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_DEV_MODEL=xiaomi/mimo-v2-flash:free
OPENROUTER_ENABLE_DEV_AUTO_FREE=true

# OpenRouter Model Preferences (optional)
OPENROUTER_PREFERRED_CATEGORY=balanced
OPENROUTER_MAX_COST_PER_REQUEST=0.50

# LLM Configuration - Gemini (Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional LLM Settings
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000
LLM_USE_OPENROUTER=true

# Other services
REDIS_URL=
REDIS_RESEND_TTL=600
REDIS_REGISTER_TTL=600
REDIS_BROKER_URL=redis://localhost:6379/1
REDIS_BACKEND_URL=redis://localhost:6379/2

# Celery Queue Names
# Use environment-specific names to prevent staging/prod workers from competing on
# the same Redis queues. Production can keep the defaults; only staging needs changes.
# Example staging values:
#   CELERY_SCRAPING_QUEUE=scraping-staging
#   CELERY_PROCESSING_QUEUE=processing-staging
#   CELERY_PERSISTENCE_QUEUE=persistence-staging
# Worker startup must match: celery ... --queues=scraping-staging,processing-staging,...
CELERY_SCRAPING_QUEUE=scraping
CELERY_PROCESSING_QUEUE=processing
CELERY_PERSISTENCE_QUEUE=persistence

# Testing settings
ALLOW_TEST_EMAIL_PROVIDERS=true
TEST_EMAIL_PROVIDERS=gmail.com

# Gemini API Key
# DEPRECATED: Gemini is now used as fallback. Use OpenRouter for primary LLM provider.
# GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=
TAVILY_API_KEY=

# Billing Configuration
TRIAL_DURATION_DAYS=14

# Frontend URL (for Stripe redirects)
FRONTEND_URL=http://localhost:3000


# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_api_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

STRIPE_API_TIMEOUT=10
STRIPE_RETRY_COUNT=3
STRIPE_RETRY_BACKOFF=0.5

STRIPE_INVOICE_DURATION_DAYS=3
STRIPE_CHECKOUT_SUCCESS_PATH=/billing/success
STRIPE_CHECKOUT_CANCEL_PATH=/billing/cancel

ESSENTIAL_MONTHLY_PRICE_USD=2900
ESSENTIAL_YEARLY_PRICE_USD=27840

PRO_MONTHLY_PRICE_USD=7900
PRO_YEARLY_PRICE_USD=75840

ENTERPRISE_MONTHLY_PRICE_USD=9900
ENTERPRISE_YEARLY_PRICE_USD=95040

STRIPE_ESSENTIAL_MONTHLY_PRODUCT_ID=prod_monthly_123
STRIPE_ESSENTIAL_MONTHLY_PRICE_ID=price_monthly_id

STRIPE_ESSENTIAL_YEARLY_PRODUCT_ID=prod_yearly_123
STRIPE_ESSENTIAL_YEARLY_PRICE_ID=price_yearly_id
STRIPE_PRO_MONTHLY_PRODUCT_ID=prod_pro_monthly_123
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly_id

STRIPE_PRO_YEARLY_PRODUCT_ID=prod_pro_yearly_123
STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly_id

STRIPE_ENTERPRISE_MONTHLY_PRODUCT_ID=prod_enterprise_monthly_123
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_enterprise_monthly_id

STRIPE_ENTERPRISE_YEARLY_PRODUCT_ID=prod_enterprise_yearly_123
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_enterprise_yearly_id

# Plan limits
ESSENTIAL_MAX_PROJECTS=1
ESSENTIAL_MAX_JURISDICTIONS=2
ESSENTIAL_MONTHLY_SCANS=20

PRO_MAX_PROJECTS=20
PRO_MAX_JURISDICTIONS=50
PRO_MONTHLY_SCANS=-1

ENTERPRISE_MAX_PROJECTS=-1
ENTERPRISE_MAX_JURISDICTIONS=-1
ENTERPRISE_MONTHLY_SCANS=-1

MODEL_NAME=
TAVILY_API_KEY=

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False
MINIO_USE_SSL=False
MINIO_PUBLIC_URL=

# MinIO Bucket Configuration
# Environment-specific buckets (automatic mapping based on ENVIRONMENT variable):
# - Main content (scraping): legalwatch (dev), legalwatch-staging, legalwatch-prod
# - Profile pictures (public): legalwatch-profile (dev), legalwatch-staging-profile, legalwatch-prod-profile
# Override defaults if needed:
MINIO_BUCKET_OVERRIDE=
MINIO_PROFILE_BUCKET_OVERRIDE=

# Scraping
SCRAPE_MAX_RETRIES = 5
SCRAPE_BASE_DELAY = 60
SCRAPE_MAX_DELAY = 3600
SCRAPE_DISPATCH_LOCK_TIMEOUT = 60
SCRAPE_BATCH_SIZE = 1000
SCRAPE_JOB_TIMEOUT_SECONDS = 3600

# invitation
INVITATION_TOKEN_EXPIRE_MINUTES = 1440

#MICROSOFT OAUTH
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback
MICROSOFT_TENANT_ID=your-app-tenant-id
MICROSOFT_CLIENT_SECRET=your-app-client-secret
MICROSOFT_CLIENT_ID=your-app-client-id
MICROSOFT_USERINFO_ENDPOINT=https://graph.microsoft.com/v1.0/me
MICROSOFT_SCOPES=["https://graph.microsoft.com/User.Read", "openid", "email", "profile"]
MICROSOFT_OAUTH_REDIRECT_NEW_USER_URL=http://localhost:3000/app
MICROSOFT_OAUTH_REDIRECT_EXISTING_USER_URL=http://localhost:3000/app
MICROSOFT_OAUTH_STATE_TTL=900

#contact us
ADMIN_EMAIL=admin@organization.com
DEMO_REQUEST_NOTIFICATION_EMAIL=hello@legalwatch.dog

# apple auth
APPLE_TEAM_ID=your-apple-developer-team-id
APPLE_CLIENT_ID=your-appple-developer-client-id
APPLE_KEY_ID=your-apple-developer-key-identifier
APPLE_PRIVATE_KEY=your-app-private-key-apple-developer
APPLE_CLIENT_SECRET_LIFETIME=expiration-time-in-seconds
APPLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/apple/callback

# api key
API_KEY_MAX_EXPIRATION_DAYS=60
API_KEY_DEFAULT_EXPIRATION_DAYS=15
API_KEY_ROTATION_WINDOW_DAYS=3
WEB_SECRET_KEY=your-we-hook
API_KEY_FRONTEND_URL=""

# Parallel AI
PARALLEL_API_KEY=your_parallel_ai_api_key

# Search Session
SEARCH_SESSION_TTL=1800

# OAuth Frontend URLs
OAUTH_DEFAULT_CLIENT=production
OAUTH_FRONTEND_LOCAL_URL=http://localhost:3000
OAUTH_FRONTEND_STAGING_URL=https://staging.minamoto.emerj.net
OAUTH_FRONTEND_PRODUCTION_URL=https://minamoto.emerj.net

# Sitemap
MAX_URLS_PER_SITEMAP=50_000
BLOG_SITE_URL=""

# Campaign Taxonomy (global SEO coverage)
CAMPAIGN_TAXONOMY_MAX_TOKENS=24000
CAMPAIGN_TAXONOMY_TEMPERATURE=0.3
CAMPAIGN_TAXONOMY_STRICT_TRUNCATION=true

CAMPAIGN_TAXONOMY_ENFORCE_GLOBAL_COVERAGE=true
CAMPAIGN_TAXONOMY_MIN_COUNTRIES_COUNTRY=180
CAMPAIGN_TAXONOMY_MIN_COUNTRIES_STATE=180

CAMPAIGN_TAXONOMY_EXPAND_REGIONAL_ENTITIES=true
CAMPAIGN_TAXONOMY_EXPAND_GLOBAL_ENTITIES=true

CAMPAIGN_TAXONOMY_EXPANSION_ENABLED=true
CAMPAIGN_TAXONOMY_EXPANSION_MAX_PASSES=2
CAMPAIGN_TAXONOMY_EXPANSION_BATCH_SIZE=40
CAMPAIGN_TAXONOMY_EXPANSION_MAX_TOKENS=12000

# Paths are relative to repo root. Replace with absolute paths in production containers if needed.
CAMPAIGN_TAXONOMY_REGION_DATASET_COUNTRIES_CSV_PATH=dataset/countries.csv
CAMPAIGN_TAXONOMY_SUBDIVISION_ENRICHMENT_ENABLED=true
CAMPAIGN_TAXONOMY_SUBDIVISION_ENRICHMENT_CSV_PATH=dataset/states.csv
CAMPAIGN_TAXONOMY_SUBDIVISION_ENRICHMENT_ALLOWED_TYPES=state,province,region,county,district,governorate,prefecture,municipality,canton,department,territory,union territory
CAMPAIGN_TAXONOMY_CITY_ENRICHMENT_ENABLED=true
CAMPAIGN_TAXONOMY_CITY_ENRICHMENT_CSV_PATH=dataset/cities.csv